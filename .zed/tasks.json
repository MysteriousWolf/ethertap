[
  {
    "label": "Check + Lint + Format",
    "command": "bash",
    "args": [
      "-c",
      "cargo clippy --workspace --all-targets -- -D warnings && cargo clippy -p ethertap --all-targets --features standalone -- -D warnings && cargo fmt --all --check"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Format",
    "command": "cargo",
    "args": ["fmt", "--all"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Build (debug)",
    "command": "cargo",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Test: full",
    "command": "cargo",
    "args": ["test", "--workspace"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Test: unit (lib only)",
    "command": "cargo",
    "args": ["test", "-p", "ethertap", "--lib"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Bench",
    "command": "cargo",
    "args": ["bench"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Run: Mock suite (mixer + MIDI)",
    "command": "cargo",
    "args": ["run", "-p", "mock-suite"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Run: Standalone (VST engine)",
    "command": "bash",
    "args": ["scripts/gui_test.sh"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Export: VST3 (release)",
    "command": "bash",
    "args": ["scripts/build.sh"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Setup: vendor/",
    "command": "bash",
    "args": ["scripts/setup.sh"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Clean",
    "command": "bash",
    "args": ["scripts/clean.sh", "--all"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
]
