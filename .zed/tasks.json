[
  {
    "label": "Check / Lint",
    "command": "cargo",
    "args": ["clippy", "--all-targets", "--", "-D", "warnings"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Format",
    "command": "cargo",
    "args": ["fmt", "--all"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Build (debug)",
    "command": "cargo",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Test",
    "command": "cargo",
    "args": ["test", "--all"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Run: Mock suite (mixer + MIDI)",
    "command": "uv",
    "args": ["run", "scripts/mock_ethertap.py"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Run: Standalone (VST engine)",
    "command": "bash",
    "args": ["scripts/gui_test.sh"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Export: VST3 (release)",
    "command": "bash",
    "args": ["scripts/build.sh"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Setup: vendor/",
    "command": "bash",
    "args": ["scripts/setup.sh"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Clean",
    "command": "bash",
    "args": ["scripts/clean.sh", "--all"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
]
