[
  {
    "label": "Format",
    "command": "cargo fmt --all",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Check",
    "command": "cargo clippy --workspace --all-targets -- -D warnings && cargo clippy -p ethertap --all-targets --features standalone -- -D warnings && cargo fmt --all --check",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Test",
    "command": "cargo test --workspace",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Coverage (≥ 95%)",
    "command": "bash scripts/coverage.sh",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Dev: Run standalone",
    "command": "cargo run --bin ethertap-gui --features standalone",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Dev: Mock suite",
    "command": "cargo run -p mock-suite",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Export VST3",
    "command": "bash scripts/build.sh",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
]
