[
  {
    "label": "Check / Lint",
    "command": "cargo",
    "args": ["clippy", "--all-targets", "--", "-D", "warnings"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Format",
    "command": "cargo",
    "args": ["fmt", "--all"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Build (debug)",
    "command": "cargo",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Test",
    "command": "cargo",
    "args": ["test", "--all"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Run: Mock mixer",
    "command": "python3",
    "args": ["scripts/mock_mixer.py"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Run: GUI test",
    "command": "bash",
    "args": ["scripts/gui_test.sh"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Export: VST3 (release)",
    "command": "cargo",
    "args": ["run", "--package", "xtask", "--", "bundle", "ethertap", "--release"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Setup: vendor/",
    "command": "bash",
    "args": ["scripts/setup.sh"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Clean",
    "command": "bash",
    "args": ["scripts/clean.sh", "--all"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
]
