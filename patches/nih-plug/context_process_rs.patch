+    /// Set a parameter value from within the process callback. Updates the
+    /// plugin's internal atomic immediately; the VST3 wrapper additionally
+    /// schedules a host notification so DAW automation readback works even when
+    /// the GUI is closed. The default implementation updates only the internal
+    /// atomic, which is sufficient for reading the value back inside the plugin.
+    fn set_parameter<Pa: crate::params::Param>(&self, param: &Pa, value: Pa::Plain) {
+        let normalized = param.preview_normalized(value);
+        // Safety: only writes to the param's own internal atomic; no host
+        // synchronisation is needed for the default (non-VST3) path.
+        unsafe { let _ = param.as_ptr().set_normalized_value(normalized); }
+    }
 }
 
