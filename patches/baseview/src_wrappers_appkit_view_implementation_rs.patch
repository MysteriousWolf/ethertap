+
+extern "C-unwind" fn set_frame_size<V: ViewImpl>(this: &View<V>, _sel: Sel, new_size: NSSize) {
+    // Call super first so the NSView frame is actually updated before we react to it.
+    unsafe {
+        let superclass = this.class().superclass().unwrap();
+        let () = msg_send![super(this, superclass), setFrameSize: new_size];
+    }
+    V::set_frame_size(this.inner_ref(), new_size);
+}
